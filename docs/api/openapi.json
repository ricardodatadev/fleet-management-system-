{
    "openapi": "3.0.0",
    "info": {
        "title": "SIGOF-M API",
        "description": "API REST do SIGOF-M (Sistema Integrado de Gestão e Otimização de Frota e Manutenção). Todas as respostas, inclusive erros, usam o envelope {status, message, errors, data[, meta]}.",
        "license": {
            "name": "Proprietary"
        },
        "version": "0.1.0"
    },
    "servers": [
        {
            "url": "/api/v1",
            "description": "API v1 (mesma origem, via nginx)"
        }
    ],
    "paths": {
        "/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login (emite token Bearer)",
                "description": "Público. Credenciais inválidas → 422 com mensagem genérica (não revela se o e-mail existe). Usuário inativo → 403 (somente com a senha correta). Rate limit: 5/min por e-mail+IP e 20/min por IP (toda tentativa conta). Token expira em SANCTUM_EXPIRATION minutos (padrão 720).",
                "operationId": "authLogin",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password",
                                    "device_name"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "admin@example.com",
                                        "maxLength": 190
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "maxLength": 255
                                    },
                                    "device_name": {
                                        "type": "string",
                                        "example": "web",
                                        "maxLength": 255
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Autenticado.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/Envelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/LoginData"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "403": {
                        "$ref": "#/components/responses/Forbidden"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "security": []
            }
        },
        "/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Logout (revoga o token atual)",
                "operationId": "authLogout",
                "responses": {
                    "200": {
                        "description": "Token revogado (`data` null).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Envelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Usuário autenticado, colaborador vinculado e permissões",
                "operationId": "authMe",
                "responses": {
                    "200": {
                        "description": "Dados da sessão.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/Envelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/MeData"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/auth/password": {
            "put": {
                "tags": [
                    "Auth"
                ],
                "summary": "Troca a própria senha (revoga os demais tokens)",
                "description": "Política: mín. 10 caracteres, com maiúscula, minúscula e número. O token usado na requisição continua válido; todos os outros do usuário são revogados.",
                "operationId": "authChangePassword",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "current_password",
                                    "password",
                                    "password_confirmation"
                                ],
                                "properties": {
                                    "current_password": {
                                        "type": "string",
                                        "format": "password"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "maxLength": 255,
                                        "minLength": 10
                                    },
                                    "password_confirmation": {
                                        "type": "string",
                                        "format": "password"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Senha alterada (`data` null).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Envelope"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/Unauthenticated"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/health": {
            "get": {
                "tags": [
                    "Infra"
                ],
                "summary": "Saúde da aplicação (db e redis)",
                "description": "Público e fora do rate limit. 503 se db ou redis estiverem fora (o corpo traz o estado de cada componente em `data`).",
                "operationId": "health",
                "responses": {
                    "200": {
                        "description": "Todos os componentes ativos.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/Envelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/HealthData"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "503": {
                        "description": "Algum componente indisponível.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/ErrorEnvelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "$ref": "#/components/schemas/HealthData"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    }
                },
                "security": []
            }
        },
        "/meta/enums": {
            "get": {
                "tags": [
                    "Infra"
                ],
                "summary": "Enums e metadados para selects (esqueleto)",
                "description": "Esqueleto vazio na F1-06. Será protegido por bearerAuth na F1-10 (perfil: qualquer autenticado).",
                "operationId": "metaEnums",
                "responses": {
                    "200": {
                        "description": "Enums disponíveis (vazio por enquanto).",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "allOf": [
                                        {
                                            "$ref": "#/components/schemas/Envelope"
                                        },
                                        {
                                            "properties": {
                                                "data": {
                                                    "properties": {
                                                        "enums": {
                                                            "type": "object"
                                                        }
                                                    },
                                                    "type": "object"
                                                }
                                            },
                                            "type": "object"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "429": {
                        "$ref": "#/components/responses/TooManyRequests"
                    },
                    "500": {
                        "$ref": "#/components/responses/ServerError"
                    }
                },
                "security": []
            }
        }
    },
    "components": {
        "schemas": {
            "LoginData": {
                "required": [
                    "token",
                    "token_type",
                    "expires_at",
                    "user"
                ],
                "properties": {
                    "token": {
                        "type": "string",
                        "example": "1|9fQk..."
                    },
                    "token_type": {
                        "type": "string",
                        "enum": [
                            "Bearer"
                        ]
                    },
                    "expires_at": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-10-09T02:03:22.123456Z"
                    },
                    "user": {
                        "$ref": "#/components/schemas/AuthUser"
                    }
                },
                "type": "object"
            },
            "MeData": {
                "required": [
                    "user",
                    "employee",
                    "permissions"
                ],
                "properties": {
                    "user": {
                        "$ref": "#/components/schemas/AuthUser"
                    },
                    "employee": {
                        "description": "Colaborador vinculado (preenchido a partir da F1-14).",
                        "type": "object",
                        "example": null,
                        "nullable": true
                    },
                    "permissions": {
                        "description": "Permissões do perfil (config/rbac.php). auth.* é implícito e não aparece.",
                        "type": "array",
                        "items": {
                            "type": "string"
                        },
                        "example": [
                            "branches.view",
                            "equipments.view"
                        ]
                    }
                },
                "type": "object"
            },
            "HealthData": {
                "required": [
                    "app",
                    "db",
                    "redis",
                    "version"
                ],
                "properties": {
                    "app": {
                        "type": "string",
                        "enum": [
                            "up"
                        ]
                    },
                    "db": {
                        "type": "string",
                        "enum": [
                            "up",
                            "down"
                        ]
                    },
                    "redis": {
                        "type": "string",
                        "enum": [
                            "up",
                            "down"
                        ]
                    },
                    "version": {
                        "type": "string",
                        "example": "0.1.0"
                    }
                },
                "type": "object"
            },
            "AuthUser": {
                "required": [
                    "id",
                    "name",
                    "email",
                    "role",
                    "branch"
                ],
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Ana Souza"
                    },
                    "email": {
                        "type": "string",
                        "format": "email",
                        "example": "ana@example.com"
                    },
                    "role": {
                        "type": "string",
                        "enum": [
                            "operator",
                            "mechanic",
                            "leader",
                            "admin"
                        ]
                    },
                    "branch": {
                        "description": "Filial do usuário; null = todas (somente admin).",
                        "required": [
                            "id",
                            "code",
                            "name"
                        ],
                        "properties": {
                            "id": {
                                "type": "integer",
                                "example": 1
                            },
                            "code": {
                                "type": "string",
                                "example": "FIL-001"
                            },
                            "name": {
                                "type": "string",
                                "example": "Matriz"
                            }
                        },
                        "type": "object",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Envelope": {
                "description": "Envelope padrão de toda resposta.",
                "required": [
                    "status",
                    "message",
                    "errors",
                    "data"
                ],
                "properties": {
                    "status": {
                        "description": "Definições globais da OpenAPI (info, servidor, segurança, schemas e respostas reutilizáveis).\nOs endpoints são anotados nos próprios controllers.",
                        "type": "string",
                        "enum": [
                            "success",
                            "error"
                        ]
                    },
                    "message": {
                        "type": "string",
                        "example": "Operação realizada com sucesso."
                    },
                    "errors": {
                        "type": "object",
                        "nullable": true,
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "data": {
                        "description": "Objeto, lista ou null conforme o endpoint (qualquer tipo)."
                    },
                    "meta": {
                        "$ref": "#/components/schemas/Pagination"
                    }
                },
                "type": "object"
            },
            "Pagination": {
                "description": "Presente (`meta`) apenas em listas paginadas.",
                "required": [
                    "current_page",
                    "per_page",
                    "total",
                    "last_page"
                ],
                "properties": {
                    "current_page": {
                        "type": "integer",
                        "example": 1
                    },
                    "per_page": {
                        "type": "integer",
                        "example": 15
                    },
                    "total": {
                        "type": "integer",
                        "example": 0
                    },
                    "last_page": {
                        "type": "integer",
                        "example": 1
                    }
                },
                "type": "object"
            },
            "ErrorEnvelope": {
                "description": "Resposta de erro (401, 403, 404, 405, 409, 429, 500, 503).",
                "required": [
                    "status",
                    "message",
                    "errors",
                    "data"
                ],
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "error"
                        ]
                    },
                    "message": {
                        "type": "string",
                        "example": "Recurso não encontrado."
                    },
                    "errors": {
                        "type": "object",
                        "example": null,
                        "nullable": true
                    },
                    "data": {
                        "description": "Sempre null em erros.",
                        "example": null
                    }
                },
                "type": "object"
            },
            "ValidationErrorEnvelope": {
                "description": "Erro de validação (422): `errors` mapeia campo → mensagens.",
                "required": [
                    "status",
                    "message",
                    "errors",
                    "data"
                ],
                "properties": {
                    "status": {
                        "type": "string",
                        "enum": [
                            "error"
                        ]
                    },
                    "message": {
                        "type": "string",
                        "example": "Os dados informados são inválidos."
                    },
                    "errors": {
                        "type": "object",
                        "example": {
                            "email": [
                                "O campo email é obrigatório."
                            ]
                        },
                        "additionalProperties": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "data": {
                        "description": "Sempre null em erros.",
                        "example": null
                    }
                },
                "type": "object"
            }
        },
        "responses": {
            "Unauthenticated": {
                "description": "Não autenticado (401).",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorEnvelope"
                        }
                    }
                }
            },
            "Forbidden": {
                "description": "Acesso negado (403).",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorEnvelope"
                        }
                    }
                }
            },
            "NotFound": {
                "description": "Recurso não encontrado (404).",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorEnvelope"
                        }
                    }
                }
            },
            "Conflict": {
                "description": "Conflito de regra de negócio (409).",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorEnvelope"
                        }
                    }
                }
            },
            "ValidationError": {
                "description": "Dados inválidos (422).",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ValidationErrorEnvelope"
                        }
                    }
                }
            },
            "TooManyRequests": {
                "description": "Limite de requisições excedido (429).",
                "headers": {
                    "Retry-After": {
                        "description": "Segundos até poder tentar novamente.",
                        "schema": {
                            "type": "integer"
                        }
                    }
                },
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorEnvelope"
                        }
                    }
                }
            },
            "ServerError": {
                "description": "Erro interno (500), sem detalhes técnicos com APP_DEBUG=false.",
                "content": {
                    "application/json": {
                        "schema": {
                            "$ref": "#/components/schemas/ErrorEnvelope"
                        }
                    }
                }
            }
        },
        "securitySchemes": {
            "bearerAuth": {
                "type": "http",
                "description": "Token obtido em POST /auth/login (expira em 12 h).",
                "bearerFormat": "Sanctum personal access token",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Auth",
            "description": "Auth"
        },
        {
            "name": "Infra",
            "description": "Infra"
        }
    ]
}
