# Copie para .env e preencha. NUNCA commite o .env.
# Todo valor "change-me" DEVE ser trocado.

# Marca (fonte única do nome do sistema). Identificadores técnicos (projeto do compose, imagens,
# rede, volumes, banco, prefixos de cache/Redis/sessão/Horizon) derivam do APP_SLUG.
# Trocar o nome: docs/renaming.md.
APP_NAME=GOF
APP_FULL_NAME="Gestão Operacional de Frotas"
APP_SLUG=gof

APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
# URL do frontend nos links de e-mail (redefinição de senha). Vazio = APP_URL (mesma origem pelo nginx).
APP_FRONTEND_URL=
WEB_HTTP_PORT=80

DB_HOST=db
DB_PORT=5432
POSTGRES_DB=gof
POSTGRES_USER=gof
POSTGRES_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PASSWORD=change-me

SANCTUM_EXPIRATION=720
# Swagger UI em /api/documentation (somente dev/homologação; em produção deixe false).
L5_SWAGGER_ENABLED=false
# Origens extras permitidas por CORS (separadas por vírgula). Vazio = nenhuma (mesma origem via nginx).
CORS_ALLOWED_ORIGINS=

# E-mail. Padrão `log` (nada sai do servidor). Em dev, o docker-compose.override.yml manda para o Mailpit
# (UI em http://127.0.0.1:${MAILPIT_UI_PORT}). O remetente usa APP_NAME como nome se MAIL_FROM_NAME ficar vazio.
MAIL_MAILER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAILPIT_UI_PORT=8025

PYTHON_SERVICE_URL=http://python:8000
NODE_PORT=3000
LARAVEL_INTERNAL_URL=http://nginx

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_DEMO_PASSWORD=change-me
