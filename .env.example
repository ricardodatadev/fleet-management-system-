# SIGOF-M — copie para .env e preencha. NUNCA commite o .env.
# Todo valor "change-me" DEVE ser trocado.

APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
WEB_HTTP_PORT=80

DB_HOST=db
DB_PORT=5432
POSTGRES_DB=sigof
POSTGRES_USER=sigof
POSTGRES_PASSWORD=change-me

REDIS_HOST=redis
REDIS_PASSWORD=change-me

SANCTUM_EXPIRATION=720
L5_SWAGGER_ENABLED=false

PYTHON_SERVICE_URL=http://python:8000
NODE_PORT=3000
LARAVEL_INTERNAL_URL=http://nginx

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me
SEED_DEMO_PASSWORD=change-me
